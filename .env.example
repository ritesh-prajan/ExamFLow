# GEMINI_API_KEY: Add your Gemini API key here to enable AI features locally via environment variables.
# Alternatively, you can add it through the Settings page in the application.
# Get your key from: https://aistudio.google.com/api-keys
GEMINI_API_KEY="[ADD_YOUR_GEMINI_API_KEY_HERE]"

# NODE_ENV: Set to 'production' in Netlify Environment Variables.
NODE_ENV="production"

# Firebase Configuration
# You can find these values in your firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
