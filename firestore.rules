rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- III. Primitives ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- II. Validation Blueprints ---

    function isValidUser(data) {
      return data.uid == request.auth.uid
        && (!data.keys().contains('email') || (data.email is string && data.email.size() <= 256))
        && (!data.keys().contains('displayName') || (data.displayName is string && data.displayName.size() <= 256))
        && (!data.keys().contains('onboardingCompleted') || data.onboardingCompleted is bool);
    }

    function isValidSubject(data) {
      return data.userId == request.auth.uid
        && (!data.keys().contains('name') || (data.name is string && data.name.size() <= 1024))
        && (!data.keys().contains('dailyHours') || (data.dailyHours is number))
        && (!data.keys().contains('examDate') || (data.examDate is string));
    }

    function isValidTopic(data) {
      return data.userId == request.auth.uid
        && (!data.keys().contains('name') || (data.name is string && data.name.size() <= 2048))
        && (!data.keys().contains('status') || (data.status is string))
        && (!data.keys().contains('mastery') || (data.mastery is number));
    }

    // --- I. Rules Match Blocks ---

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);

      match /subjects/{subjectId} {
        allow list: if isOwner(uid);
        allow get: if isOwner(uid);
        allow create: if isOwner(uid) && isValidId(subjectId);
        allow update: if isOwner(uid) && isValidId(subjectId);
        allow delete: if isOwner(uid);

        match /topics/{topicId} {
          allow list: if isOwner(uid);
          allow get: if isOwner(uid);
          allow create: if isOwner(uid) && isValidId(topicId);
          allow update: if isOwner(uid) && isValidId(topicId);
          allow delete: if isOwner(uid);
        }
      }
    }
  }
}
